#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x5fb76ca1ff10 .scope module, "pe_tb" "pe_tb" 2 3;
 .timescale -9 -12;
v0x5fb76ca42f40_0 .var "a_in", 7 0;
v0x5fb76ca43020_0 .net "a_out", 7 0, v0x5fb76ca13200_0;  1 drivers
v0x5fb76ca430c0_0 .net "acc", 31 0, v0x5fb76ca135c0_0;  1 drivers
v0x5fb76ca43160_0 .var "b_in", 7 0;
v0x5fb76ca43230_0 .net "b_out", 7 0, v0x5fb76ca42a80_0;  1 drivers
v0x5fb76ca432d0_0 .var "clk", 0 0;
v0x5fb76ca433a0_0 .var "en", 0 0;
v0x5fb76ca43470_0 .var/i "fail_count", 31 0;
v0x5fb76ca43510_0 .var/i "pass_count", 31 0;
v0x5fb76ca435b0_0 .var "rst", 0 0;
S_0x5fb76ca200a0 .scope task, "check" "check" 2 17, 2 17 0, S_0x5fb76ca1ff10;
 .timescale -9 -12;
v0x5fb76ca0f860_0 .var "expected", 31 0;
v0x5fb76ca10a10_0 .var "got", 31 0;
v0x5fb76ca118c0_0 .var "test_num", 7 0;
TD_pe_tb.check ;
    %load/vec4 v0x5fb76ca10a10_0;
    %load/vec4 v0x5fb76ca0f860_0;
    %cmp/e;
    %jmp/0xz  T_0.0, 6;
    %vpi_call 2 23 "$display", "  TEST %0d PASSED: acc=%0d (expected %0d)", v0x5fb76ca118c0_0, v0x5fb76ca10a10_0, v0x5fb76ca0f860_0 {0 0 0};
    %load/vec4 v0x5fb76ca43510_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5fb76ca43510_0, 0, 32;
    %jmp T_0.1;
T_0.0 ;
    %vpi_call 2 26 "$display", "  TEST %0d FAILED: acc=%0d (expected %0d)", v0x5fb76ca118c0_0, v0x5fb76ca10a10_0, v0x5fb76ca0f860_0 {0 0 0};
    %load/vec4 v0x5fb76ca43470_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5fb76ca43470_0, 0, 32;
T_0.1 ;
    %end;
S_0x5fb76ca425a0 .scope module, "dut" "pe" 2 9, 3 1 0, S_0x5fb76ca1ff10;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst";
    .port_info 2 /INPUT 1 "en";
    .port_info 3 /INPUT 8 "a_in";
    .port_info 4 /INPUT 8 "b_in";
    .port_info 5 /OUTPUT 8 "a_out";
    .port_info 6 /OUTPUT 8 "b_out";
    .port_info 7 /OUTPUT 32 "acc";
v0x5fb76ca12350_0 .net "a_in", 7 0, v0x5fb76ca42f40_0;  1 drivers
v0x5fb76ca13200_0 .var "a_out", 7 0;
v0x5fb76ca135c0_0 .var "acc", 31 0;
v0x5fb76ca429a0_0 .net "b_in", 7 0, v0x5fb76ca43160_0;  1 drivers
v0x5fb76ca42a80_0 .var "b_out", 7 0;
v0x5fb76ca42bb0_0 .net "clk", 0 0, v0x5fb76ca432d0_0;  1 drivers
v0x5fb76ca42c70_0 .net "en", 0 0, v0x5fb76ca433a0_0;  1 drivers
v0x5fb76ca42d30_0 .net "rst", 0 0, v0x5fb76ca435b0_0;  1 drivers
E_0x5fb76c9e56a0 .event posedge, v0x5fb76ca42bb0_0;
    .scope S_0x5fb76ca425a0;
T_1 ;
    %wait E_0x5fb76c9e56a0;
    %load/vec4 v0x5fb76ca42d30_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_1.0, 8;
    %pushi/vec4 0, 0, 32;
    %assign/vec4 v0x5fb76ca135c0_0, 0;
    %pushi/vec4 0, 0, 8;
    %assign/vec4 v0x5fb76ca13200_0, 0;
    %pushi/vec4 0, 0, 8;
    %assign/vec4 v0x5fb76ca42a80_0, 0;
    %jmp T_1.1;
T_1.0 ;
    %load/vec4 v0x5fb76ca42c70_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_1.2, 8;
    %load/vec4 v0x5fb76ca135c0_0;
    %load/vec4 v0x5fb76ca12350_0;
    %pad/u 32;
    %load/vec4 v0x5fb76ca429a0_0;
    %pad/u 32;
    %mul;
    %add;
    %assign/vec4 v0x5fb76ca135c0_0, 0;
    %load/vec4 v0x5fb76ca12350_0;
    %assign/vec4 v0x5fb76ca13200_0, 0;
    %load/vec4 v0x5fb76ca429a0_0;
    %assign/vec4 v0x5fb76ca42a80_0, 0;
T_1.2 ;
T_1.1 ;
    %jmp T_1;
    .thread T_1;
    .scope S_0x5fb76ca1ff10;
T_2 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5fb76ca43510_0, 0, 32;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5fb76ca43470_0, 0, 32;
    %end;
    .thread T_2;
    .scope S_0x5fb76ca1ff10;
T_3 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5fb76ca432d0_0, 0, 1;
    %end;
    .thread T_3;
    .scope S_0x5fb76ca1ff10;
T_4 ;
    %delay 5000, 0;
    %load/vec4 v0x5fb76ca432d0_0;
    %inv;
    %store/vec4 v0x5fb76ca432d0_0, 0, 1;
    %jmp T_4;
    .thread T_4;
    .scope S_0x5fb76ca1ff10;
T_5 ;
    %vpi_call 2 33 "$dumpfile", "sim/vcd/pe_tb.vcd" {0 0 0};
    %vpi_call 2 34 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5fb76ca1ff10 {0 0 0};
    %vpi_call 2 35 "$display", "=== PE TESTBENCH START ===" {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5fb76ca435b0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5fb76ca433a0_0, 0, 1;
    %pushi/vec4 0, 0, 8;
    %store/vec4 v0x5fb76ca42f40_0, 0, 8;
    %pushi/vec4 0, 0, 8;
    %store/vec4 v0x5fb76ca43160_0, 0, 8;
    %wait E_0x5fb76c9e56a0;
    %delay 1000, 0;
    %vpi_call 2 40 "$display", "[TEST 1] Reset" {0 0 0};
    %load/vec4 v0x5fb76ca430c0_0;
    %store/vec4 v0x5fb76ca10a10_0, 0, 32;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5fb76ca0f860_0, 0, 32;
    %pushi/vec4 1, 0, 8;
    %store/vec4 v0x5fb76ca118c0_0, 0, 8;
    %fork TD_pe_tb.check, S_0x5fb76ca200a0;
    %join;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5fb76ca435b0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5fb76ca433a0_0, 0, 1;
    %pushi/vec4 3, 0, 8;
    %store/vec4 v0x5fb76ca42f40_0, 0, 8;
    %pushi/vec4 4, 0, 8;
    %store/vec4 v0x5fb76ca43160_0, 0, 8;
    %vpi_call 2 44 "$display", "[TEST 2] 3x4=12" {0 0 0};
    %wait E_0x5fb76c9e56a0;
    %delay 1000, 0;
    %load/vec4 v0x5fb76ca430c0_0;
    %store/vec4 v0x5fb76ca10a10_0, 0, 32;
    %pushi/vec4 12, 0, 32;
    %store/vec4 v0x5fb76ca0f860_0, 0, 32;
    %pushi/vec4 2, 0, 8;
    %store/vec4 v0x5fb76ca118c0_0, 0, 8;
    %fork TD_pe_tb.check, S_0x5fb76ca200a0;
    %join;
    %pushi/vec4 5, 0, 8;
    %store/vec4 v0x5fb76ca42f40_0, 0, 8;
    %pushi/vec4 6, 0, 8;
    %store/vec4 v0x5fb76ca43160_0, 0, 8;
    %vpi_call 2 49 "$display", "[TEST 3] 12+(5x6)=42" {0 0 0};
    %wait E_0x5fb76c9e56a0;
    %delay 1000, 0;
    %load/vec4 v0x5fb76ca430c0_0;
    %store/vec4 v0x5fb76ca10a10_0, 0, 32;
    %pushi/vec4 42, 0, 32;
    %store/vec4 v0x5fb76ca0f860_0, 0, 32;
    %pushi/vec4 3, 0, 8;
    %store/vec4 v0x5fb76ca118c0_0, 0, 8;
    %fork TD_pe_tb.check, S_0x5fb76ca200a0;
    %join;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5fb76ca433a0_0, 0, 1;
    %pushi/vec4 99, 0, 8;
    %store/vec4 v0x5fb76ca42f40_0, 0, 8;
    %pushi/vec4 99, 0, 8;
    %store/vec4 v0x5fb76ca43160_0, 0, 8;
    %vpi_call 2 54 "$display", "[TEST 4] Enable gate: acc stays 42" {0 0 0};
    %wait E_0x5fb76c9e56a0;
    %delay 1000, 0;
    %load/vec4 v0x5fb76ca430c0_0;
    %store/vec4 v0x5fb76ca10a10_0, 0, 32;
    %pushi/vec4 42, 0, 32;
    %store/vec4 v0x5fb76ca0f860_0, 0, 32;
    %pushi/vec4 4, 0, 8;
    %store/vec4 v0x5fb76ca118c0_0, 0, 8;
    %fork TD_pe_tb.check, S_0x5fb76ca200a0;
    %join;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5fb76ca433a0_0, 0, 1;
    %pushi/vec4 255, 0, 8;
    %store/vec4 v0x5fb76ca42f40_0, 0, 8;
    %pushi/vec4 255, 0, 8;
    %store/vec4 v0x5fb76ca43160_0, 0, 8;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5fb76ca435b0_0, 0, 1;
    %wait E_0x5fb76c9e56a0;
    %delay 1000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5fb76ca435b0_0, 0, 1;
    %wait E_0x5fb76c9e56a0;
    %delay 1000, 0;
    %vpi_call 2 61 "$display", "[TEST 5] 255x255=65025" {0 0 0};
    %load/vec4 v0x5fb76ca430c0_0;
    %store/vec4 v0x5fb76ca10a10_0, 0, 32;
    %pushi/vec4 65025, 0, 32;
    %store/vec4 v0x5fb76ca0f860_0, 0, 32;
    %pushi/vec4 5, 0, 8;
    %store/vec4 v0x5fb76ca118c0_0, 0, 8;
    %fork TD_pe_tb.check, S_0x5fb76ca200a0;
    %join;
    %vpi_call 2 64 "$display", "=== RESULTS: %0d PASSED %0d FAILED ===", v0x5fb76ca43510_0, v0x5fb76ca43470_0 {0 0 0};
    %vpi_call 2 65 "$finish" {0 0 0};
    %end;
    .thread T_5;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "tb/pe_tb.v";
    "rtl/pe/pe.v";
